DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require"

# Required for the AI assistant + insights features (app/api/assistant, app/api/insights).
# Get a key at https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Required for login sessions. Generate one with: openssl rand -base64 32
AUTH_SECRET=

# Required for Face ID / passkeys (WebAuthn) to work in production. Must be
# the exact public URL the browser sees, no trailing slash — e.g.
# https://cv-fec46dd68ed4.ewr.prisma.build. Without this, Face ID fails
# behind a reverse proxy (the platform's internal request URL doesn't match
# what the browser sees, and WebAuthn requires an exact match). Not needed
# for local dev (localhost has no proxy in the way).
AUTH_ORIGIN=
