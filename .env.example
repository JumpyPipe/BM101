DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require"

# Required for the AI assistant + insights features (app/api/assistant, app/api/insights).
# Get a key at https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Required for login sessions. Generate one with: openssl rand -base64 32
AUTH_SECRET=

# Required for Face ID / passkeys (WebAuthn) to work in production. Must be
# the exact public URL the browser sees, no trailing slash — e.g.
# https://cv-fec46dd68ed4.ewr.prisma.build. Without this, Face ID fails
# behind a reverse proxy (the platform's internal request URL doesn't match
# what the browser sees, and WebAuthn requires an exact match). Not needed
# for local dev (localhost has no proxy in the way).
AUTH_ORIGIN=

# Optional: enables "Continue with Google" / "Continue with Apple" one-click
# sign up/in (via Auth.js). Each pair is independent — set only the ones you
# want; a provider's button is hidden entirely when its vars are unset.
#
# AUTH_URL is Auth.js's equivalent of AUTH_ORIGIN above — same "public URL,
# not the proxy's internal request URL" problem, same fix. Required in
# production once either provider is configured; not needed locally.
AUTH_URL=

# Google: create an OAuth client at https://console.cloud.google.com/apis/credentials
# (type "Web application"), with authorized redirect URI:
#   <AUTH_URL>/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Apple: create a Services ID + key at https://developer.apple.com/account/resources/identifiers
# with redirect URI:
#   <AUTH_URL>/api/auth/callback/apple
# AUTH_APPLE_SECRET is a signed JWT (not a raw string) generated from your
# Team ID, Key ID, and private key — `npx auth add apple` (from next-auth)
# can generate it for you.
AUTH_APPLE_ID=
AUTH_APPLE_SECRET=
