# next-auth@beta's optional (unused) WebAuthn provider peer-depends on
# @simplewebauthn/browser@^9, while the app uses 13.x for its real Face ID
# feature. Confirmed peerOptional (safe to override). Without this, a plain
# `npm install` on the deploy pipeline (not `npm ci`) would fail on the
# conflict.
legacy-peer-deps=true
