// Prisma schema for BM101 — Baby Management App
// See PLANNING.md section 3 for the data model rationale.

generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// A private family/group — the ownership boundary. A caregiver only ever
/// sees babies belonging to a household they're a member of (see
/// HouseholdMembership). Joining requires an invite link (HouseholdInvite);
/// there's no open "browse households" path anywhere in the app.
model Household {
  id        String   @id @default(cuid())
  name      String   @default("My Family")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  babies      Baby[]
  memberships HouseholdMembership[]
  invites     HouseholdInvite[]
}

enum HouseholdRole {
  /// Full control: manage babies, invite/remove members, delete the household.
  OWNER
  /// Can log data and view everything, but not manage membership.
  MEMBER
}

/// Join table: which caregivers belong to which households, and with what
/// role. A caregiver (one real person's account) can belong to more than
/// one household — e.g. a grandparent helping two different families.
model HouseholdMembership {
  id          String        @id @default(cuid())
  householdId String
  household   Household     @relation(fields: [householdId], references: [id], onDelete: Cascade)
  caregiverId String
  caregiver   Caregiver     @relation(fields: [caregiverId], references: [id], onDelete: Cascade)
  role        HouseholdRole @default(MEMBER)

  createdAt DateTime @default(now())

  @@unique([householdId, caregiverId])
  @@index([caregiverId])
}

/// A shareable, single-use join link for a household. Anyone who opens
/// /invite/[token] and either signs up or signs in gets added as a member
/// — this is the only way into a household that isn't already yours.
model HouseholdInvite {
  id          String        @id @default(cuid())
  householdId String
  household   Household     @relation(fields: [householdId], references: [id], onDelete: Cascade)
  token       String        @unique
  role        HouseholdRole @default(MEMBER)

  createdById String
  createdBy   Caregiver @relation("InvitesCreated", fields: [createdById], references: [id])

  expiresAt DateTime?
  usedAt    DateTime?
  usedById  String?
  usedBy    Caregiver? @relation("InvitesUsed", fields: [usedById], references: [id])

  createdAt DateTime @default(now())

  @@index([householdId])
  @@index([token])
}

model Baby {
  id          String    @id @default(cuid())
  householdId String
  household   Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
  name        String
  dob         DateTime
  sex         Sex       @default(UNKNOWN)
  photoUrl    String?
  notes       String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  feedingLogs  FeedingLog[]
  sleepLogs    SleepLog[]
  diaperLogs   DiaperLog[]
  growthLogs   GrowthLog[]
  milestones   Milestone[]
  chatMessages ChatMessage[]
  insights     Insight[]
  predictions  Prediction[]
  tips         Tip[]

  @@index([householdId])
}

enum Sex {
  MALE
  FEMALE
  UNKNOWN
}

model Caregiver {
  id   String @id @default(cuid())
  name String
  role String @default("Parent")

  // Nullable: existing caregivers predate login and start out
  // unclaimed (no way to sign in) until someone sets these via the
  // bootstrap flow or the caregiver edit form.
  email        String? @unique
  passwordHash String?

  credentials     WebAuthnCredential[]
  memberships     HouseholdMembership[]
  invitesCreated  HouseholdInvite[]     @relation("InvitesCreated")
  invitesUsed     HouseholdInvite[]     @relation("InvitesUsed")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model WebAuthnCredential {
  id          String    @id @default(cuid())
  caregiverId String
  caregiver   Caregiver @relation(fields: [caregiverId], references: [id], onDelete: Cascade)

  credentialId String @unique
  publicKey    Bytes
  counter      Int    @default(0)
  deviceLabel  String?

  createdAt DateTime @default(now())

  @@index([caregiverId])
}

model FeedingLog {
  id          String       @id @default(cuid())
  babyId      String
  baby        Baby         @relation(fields: [babyId], references: [id], onDelete: Cascade)
  type        FeedingType
  side        FeedingSide?
  amountMl    Float?
  durationMin Float?
  startedAt   DateTime
  note        String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([babyId, startedAt])
}

enum FeedingType {
  BREAST
  BOTTLE
  SOLID
}

enum FeedingSide {
  LEFT
  RIGHT
  BOTH
}

model SleepLog {
  id        String    @id @default(cuid())
  babyId    String
  baby      Baby      @relation(fields: [babyId], references: [id], onDelete: Cascade)
  type      SleepType
  startedAt DateTime
  endedAt   DateTime?
  note      String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([babyId, startedAt])
}

enum SleepType {
  NAP
  NIGHT
}

model DiaperLog {
  id         String     @id @default(cuid())
  babyId     String
  baby       Baby       @relation(fields: [babyId], references: [id], onDelete: Cascade)
  type       DiaperType
  occurredAt DateTime
  note       String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([babyId, occurredAt])
}

enum DiaperType {
  WET
  DIRTY
  MIXED
}

model GrowthLog {
  id         String   @id @default(cuid())
  babyId     String
  baby       Baby     @relation(fields: [babyId], references: [id], onDelete: Cascade)
  measuredAt DateTime
  weightKg   Float?
  heightCm   Float?
  headCm     Float?
  note       String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([babyId, measuredAt])
}

model Milestone {
  id          String   @id @default(cuid())
  babyId      String
  baby        Baby     @relation(fields: [babyId], references: [id], onDelete: Cascade)
  occurredAt  DateTime
  category    String
  title       String
  description String?
  photoUrl    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([babyId, occurredAt])
}

model ChatMessage {
  id        String      @id @default(cuid())
  babyId    String
  baby      Baby        @relation(fields: [babyId], references: [id], onDelete: Cascade)
  role      MessageRole
  content   String
  createdAt DateTime    @default(now())

  @@index([babyId, createdAt])
}

enum MessageRole {
  USER
  ASSISTANT
}

model Insight {
  id        String          @id @default(cuid())
  babyId    String
  baby      Baby            @relation(fields: [babyId], references: [id], onDelete: Cascade)
  category  String
  severity  InsightSeverity @default(INFO)
  title     String
  body      String
  createdAt DateTime        @default(now())

  @@index([babyId, createdAt])
}

enum InsightSeverity {
  INFO
  TIP
  ATTENTION
}

model Prediction {
  id                 String               @id @default(cuid())
  babyId             String
  baby               Baby                 @relation(fields: [babyId], references: [id], onDelete: Cascade)
  eventType          PredictionEventType
  predictedTime      DateTime
  confidence         Float
  generatedAt        DateTime             @default(now())
  resolvedActualTime DateTime?

  @@index([babyId, eventType, generatedAt])
}

enum PredictionEventType {
  FEEDING
  SLEEP
}

model Tip {
  id             String    @id @default(cuid())
  babyId         String
  baby           Baby      @relation(fields: [babyId], references: [id], onDelete: Cascade)
  category       TipCategory
  content        String
  ageDaysMin     Int?
  ageDaysMax     Int?
  shownAt        DateTime?
  dismissed      Boolean   @default(false)
  usefulFeedback Boolean?

  createdAt DateTime @default(now())

  @@index([babyId, dismissed])
}

enum TipCategory {
  SLEEP
  FEEDING
  DEVELOPMENT
  SAFETY
}
